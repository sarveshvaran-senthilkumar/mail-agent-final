# =====================================================================
# MAIL AGENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials & IP addresses.
# DO NOT commit your actual .env file to Git!
# =====================================================================

# 1. GMAIL OAUTH2 SETUP
# Download credentials.json from Google Cloud Console and place it in project root
GMAIL_CLIENT_SECRET_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_START_DATE=2026-09-09

# 2. MONGODB SETUP
# Local MongoDB or cloud connection string (e.g. mongodb://localhost:27017 or mongodb+srv://...)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=mail_agent

# 3. ON-PREM QWEN LLM ENDPOINT SETUP
# Base URL of your LLM server (e.g. http://192.168.1.50:19298/v1 or http://175.155.64.191:19298/v1)
QWEN_BASE_URL=http://YOUR_LLM_SERVER_IP:19298/v1
QWEN_MODEL=Qwen/Qwen3.5-9B
QWEN_API_KEY=EMPTY
QWEN_TIMEOUT_SECONDS=300

# 4. LOCAL STORAGE PATHS
STORAGE_ROOT=./storage
INBOX_FOLDER=./storage/inbox
REASON_FOLDER=./storage/reason

# 5. LOGGING LEVEL (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
